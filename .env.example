# Postgres
POSTGRES_USER=royd
POSTGRES_PASSWORD=royd_dev_pw
POSTGRES_DB=royd
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
JWT_SECRET=change-me-in-production-use-at-least-32-chars-long-random-string
# Short-lived access token; the frontend refreshes it silently.
JWT_ACCESS_TTL_MINUTES=15
# Upper bound on a session that is kept alive by continuous activity.
JWT_REFRESH_TTL_DAYS=7
# Log out after this long with no user activity at all. Activity — API calls,
# clicks, typing, mouse movement — slides the window, so an active user is
# never logged out by it.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Frontend
FRONTEND_PORT=5173
# Leave empty to serve the API from the same origin as the app (recommended:
# the httpOnly refresh cookie then needs no CORS credentials). If you do point
# this at another origin, list that origin in CORS_ORIGINS — "*" disables
# credentials and the session will not survive a reload.
VITE_API_URL=

# MailHog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
